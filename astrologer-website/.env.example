# Copy to .env and export these before running in any shared environment.
# The defaults in settings.py are development-only.

NAKSHATRA_SECRET_KEY=replace-me-with-50-random-characters
NAKSHATRA_DEBUG=false
NAKSHATRA_ALLOWED_HOSTS=example.com,www.example.com
NAKSHATRA_CSRF_TRUSTED_ORIGINS=https://example.com
NAKSHATRA_TIME_ZONE=Asia/Kolkata

# Where consultation requests are sent. The default backend prints to the
# console, which is what you want locally.
NAKSHATRA_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
NAKSHATRA_FROM_EMAIL=desk@example.com
NAKSHATRA_DESK_EMAIL=desk@example.com
