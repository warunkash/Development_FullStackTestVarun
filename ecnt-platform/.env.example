# ============================================================
# ECNT Platform - Environment Variables Example
# Copy this file to .env and fill in your values
# ============================================================

# Application
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
APP_NAME=ECNT Platform
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ecnt_db
DATABASE_USER=ecnt_user
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=86400

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
JWT_ALGORITHM=HS256

# Service URLs (internal communication)
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
CHARGING_SERVICE_URL=http://charging-service:3003
OCPP_SERVICE_URL=http://ocpp-service:3004
OCPP_WS_PORT=9000
PAYMENT_SERVICE_URL=http://payment-service:3005
ANALYTICS_SERVICE_URL=http://analytics-service:3006
BILLING_SERVICE_URL=http://billing-service:3007
FLEET_SERVICE_URL=http://fleet-service:3008
FRANCHISE_SERVICE_URL=http://franchise-service:3009
NOTIFICATION_SERVICE_URL=http://notification-service:3010

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ecnt-uploads
AWS_CLOUDFRONT_URL=
AWS_SES_REGION=ap-south-1

# Payment Gateways
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@ecnt.in
EMAIL_FROM_NAME=ECNT Platform

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# AI/ML
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
HUGGINGFACE_API_KEY=

# Monitoring & Observability
GRAFANA_URL=http://localhost:3030
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:14268
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# Encryption
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm

# Admin Portal
ADMIN_PORTAL_PORT=4000
ADMIN_PORTAL_URL=http://localhost:4000

# Carbon Credits
CARBON_CREDIT_VERIFIER=
CARBON_CREDIT_API_URL=

# OCPP
OCPP_HEARTBEAT_INTERVAL=60
OCPP_BOOT_RETRY_INTERVAL=30

# Feature Flags
ENABLE_CARBON_CREDITS=true
ENABLE_FLEET_MANAGEMENT=true
ENABLE_FRANCHISE_MODULE=true
ENABLE_CAFE_MODULE=true
ENABLE_WATER_PLANT=true
ENABLE_SOLAR_MONITORING=true
ENABLE_AI_PREDICTIONS=false
