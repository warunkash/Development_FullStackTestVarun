# ============================================================
# MentorOS — Environment Configuration
# Copy to .env and fill in values
# ============================================================

# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-32-char-string-minimum

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_PASSWORD=mentorios_dev_pass
DATABASE_URL=postgresql+asyncpg://mentorios:mentorios_dev_pass@localhost:5432/mentorios

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mentorios_dev_pass

# ── Object Storage (MinIO) ────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── AI Models ─────────────────────────────────────────────────
WHISPER_MODEL=large-v3-turbo
EMBEDDING_MODEL=BAAI/bge-m3
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
VIDEO_LLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
DEVICE=cpu  # "cuda" for GPU

# ── vLLM ──────────────────────────────────────────────────────
VLLM_BASE_URL=http://localhost:8100
VLLM_API_KEY=mentorios-local

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_PASSWORD=admin

# ── Hugging Face (for model downloads) ───────────────────────
HF_TOKEN=your_huggingface_token_here

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8001
